# Copy to .env and fill in values, or export these directly in your shell.
# All scripts in scripts/ fall back to ./data and ./outputs if unset.

# Root directory containing splits/ (CSVs) and images/ (sidewalk-view imagery).
# See data/README.md for the expected layout and how to obtain the data.
WALKABILITY_DATA_DIR=./data

# Directory where trained model checkpoints and result CSVs are written.
WALKABILITY_OUTPUT_DIR=./outputs
